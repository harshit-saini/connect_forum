# --- Database (Neon) ---
# Pooled URL for the app, direct URL for migrations. Local Postgres works too.
DATABASE_URL=postgres://cf:cf@localhost:5432/connect_forum
DIRECT_DATABASE_URL=postgres://cf:cf@localhost:5432/connect_forum

# --- App ---
APP_URL=http://localhost:3000
# openssl rand -base64 48
AUTH_SECRET=change-me-change-me-change-me-change-me
# openssl rand -hex 24
CRON_SECRET=change-me-change-me
# Comma-separated; checked against the verified sign-in email
ADMIN_EMAILS=admin@example.com

# --- Email (Resend) ---
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
FROM_EMAIL="Connect <no-reply@mail.example.com>"

# --- Vault: 32 random bytes, base64. openssl rand -base64 32 ---
VAULT_ENCRYPTION_KEY=
# Rotation: put the new key above, bump VAULT_KEY_VERSION, move the old key to
# VAULT_PREVIOUS_KEYS as "1:<base64>", then run `pnpm vault:rotate`.
VAULT_KEY_VERSION=1
VAULT_PREVIOUS_KEYS=

# --- AI (Azure AI Foundry) ---
FOUNDRY_ENDPOINT=
FOUNDRY_API_KEY=
LLM_DEPLOYMENT=
EMBEDDING_ENDPOINT=
EMBEDDING_API_KEY=
EMBEDDING_DEPLOYMENT=text-embedding-3-small
ENABLE_EMBEDDINGS=true
# true = offline mock LLM, embeddings and email (no keys needed)
MOCK_AI=true

# --- Tunables ---
RATING_DELAY_DAYS=3
MAX_PENDING_REQUESTS=3
MIN_GUIDE_EXPERIENCE_YEARS=3
MATCH_COOLDOWN_MINUTES=60
MATCH_MAX_RUNS_PER_DAY=3
MATCH_MAX_CONCURRENCY=5
MAX_LLM_RUNS_PER_DAY=200
